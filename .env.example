# Generate: python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
APP_ENCRYPTION_KEY=replace-with-a-32-byte-urlsafe-base64-key
SESSION_SECRET=replace-with-a-long-random-value
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=change-me-before-deploying
POSTGRES_DB=portfolio
DATABASE_URL=postgresql+asyncpg://portfolio:change-me-before-deploying@postgres:5432/portfolio
REDIS_URL=redis://redis:6379/0
# Production: set these to your Tailscale hostname/IP; keep empty for same-origin proxy.
ALLOWED_ORIGINS=
COOKIE_SECURE=true
BOOTSTRAP_USERNAME=admin
BOOTSTRAP_PASSWORD=change-me-immediately
RECONCILE_INTERVAL_SECONDS=45
STALE_WARNING_SECONDS=10
STALE_SECONDS=30
DISCONNECTED_SECONDS=60
